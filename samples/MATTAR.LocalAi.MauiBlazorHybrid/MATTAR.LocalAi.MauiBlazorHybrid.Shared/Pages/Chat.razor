@page "/chat"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IChat ChatService
@using System.Diagnostics;
@using MATTAR.LocalAi.Abstractions

<PageTitle>Chat</PageTitle>

<section class="container col">
    <header class="row container padding">
        <h1 class="row">@conversation.Title</h1>
        <span class="row">@conversation.CreatedAt.ToShortDateString()</span>
    </header>

    <section @ref="chatContainer" class="row container block padding" style="height: 65vh; overflow-y: auto;">
        @foreach (Message msg in conversation.Messages)
        {
            <section class="card-4 padding margin @(msg.Autors == "User" ? "grey text-dark-gray" : "")">
                <section class="card-header">
                    <h3>@msg.Autors</h3>
                </section>
                <section class="card-body">
                    @{dynamic message = msg.Autors == "User" ? msg.Content : (MarkupString)msg.HtmlContent;}
                    @message
                </section>
            </section>
        }
    </section>
    <footer class="row col container padding" >
        <textarea @ref="inputChat" id="question" class="block margin row" rows="3" @bind="userMessage" @onkeypress="HandleKeyPress" />
        <input @ref="sendButton" id="button" type="button" class="btn green right row" value="Send" @onclick="() => Task.Run(DisplayAssistantMessage)" />
        <input @ref="stopButton" id="stopButton" type="button" class="btn red right row hide" value="Stop" @onclick="() => Task.Run(StopGeneration)" />
    </footer>
</section>
